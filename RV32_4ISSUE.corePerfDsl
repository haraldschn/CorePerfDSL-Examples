/*********************************** Microaction Section ***********************************/
Connector {Pc_mp, Pc_pt, Pc_p, Pc_p_j, Pc_p_jr, Pc_c}
Connector {Ic_out, Ic_in}
Connector {Dc_out, Dc_in}
Connector {Xa, Xb, Xd}

Resource {PCGen, ICacheCtrl, IScan, Decoder} 
Resource {Rename}
Resource {Issue(2)}
Resource {OperandLookup}
Resource {ALU, STORE, LOAD, CSR}
Resource {MUL1, MUL2, MUL3, MUL4}
Resource {DIV(divider), DIVU(divider_u)}
Resource {ICache(iCacheModel), DCache(dCacheModel), DCache_Store(3)}
Resource {Commit(2)}

Microaction {
  uA_PCGen      (PCGen),
  uA_PcCorrect  (Pc_mp),
  uA_CacheBlock (Ic_out),

  uA_ICacheCtrl (ICacheCtrl),
  uA_PcPredict  (Pc_pt),
  uA_ICache     (ICache -> Ic_in),
  uA_IScan      (IScan),
  uA_IScan_br   (IScan -> Pc_p),
  uA_IScan_j    (IScan -> Pc_p_j),
  uA_IScan_jr   (IScan -> Pc_p_jr),

  uA_Decode        (Decoder),
  uA_Rename        (Rename),

  uA_OF_A_alu      (Xa),
  uA_OF_A_agu      (Xa),
  uA_OF_A_store    (Xa),
  uA_OF_B_alu      (Xb),
  uA_OF_B_agu      (Xb),
  uA_OF_B_store    (Xb),

  uA_Issue_ALU     (Issue),
  uA_Issue_AGU     (Issue),
  uA_Issue_STORE   (Issue),

  uA_LookUP_ALU    (OperandLookup),
  uA_LookUP_AGU    (OperandLookup),
  uA_LookUP_STORE  (OperandLookup),

  uA_ALU_RegUpdate (ALU -> Xd),
  uA_ALU_Jr        (ALU -> Xd),
  uA_ALU_Branch    (ALU),
  uA_CSR           (CSR -> Xd),
  uA_STORE         (STORE -> Dc_in),
  uA_LOAD          (LOAD),
  uA_MUL1          (MUL1),
  uA_MUL2          (MUL2),
  uA_MUL3          (MUL3),
  uA_MUL           (MUL4 -> Xd),
  uA_DIV           (DIV -> Xd),
  uA_DIVU          (DIVU -> Xd),

  uA_DCache        (DCache -> Xd),

  uA_DCache_Store  (DCache_Store),
  uA_Commit_JB     (Commit -> Pc_c),
  uA_Commit        (Commit)
}

/************************************ Stages & Pipeline ************************************/

// IF Substages
Stage {
    PC_substage   [capacity:4]  (uA_PCGen, uA_PcCorrect, uA_CacheBlock),
    IF_substage_0 [capacity:4]  (uA_ICacheCtrl),            // IFetchPipeline fetch0
    IF_substage_1 [capacity:4]  (uA_ICache, uA_PcPredict),  // IFetchPipeline fetch1
    IF_substage_2 [capacity:4]  (uA_IScan, uA_IScan_br, uA_IScan_j, uA_IScan_jr)
}

// IF Subpipeline
Pipeline IF_subpipe (PC_substage -> IF_substage_0 -> IF_substage_1 -> IF_substage_2)

// IssueQueue Substages
Stage {
  IS_substage_alu     [capacity:24] (uA_Issue_ALU),
  IS_substage_agu     [capacity:16] (uA_Issue_AGU),
  IS_substage_store   [capacity:16] (uA_Issue_STORE)
}

// OperandLookup Substages
Stage {
  LD_substage_alu     [capacity:3] (uA_LookUP_ALU, uA_OF_A_alu, uA_OF_B_alu),
  LD_substage_agu     [capacity:2] (uA_LookUP_AGU, uA_OF_A_agu, uA_OF_B_agu),
  LD_substage_store   [capacity:2] (uA_LookUP_STORE, uA_OF_A_store, uA_OF_B_store)
}

// EX Substages
Stage {
    EX_substage_alu    [capacity:3] (uA_ALU_RegUpdate),
    EX_substage_mul_1  [capacity:2] (uA_MUL1),
    EX_substage_mul_2  [capacity:2] (uA_MUL2),
    EX_substage_mul_3  [capacity:2] (uA_MUL3),
    EX_substage_mul_4  [capacity:2] (uA_MUL),
    EX_substage_branch [capacity:2] (uA_ALU_Branch, uA_ALU_Jr),
    EX_substage_div             (uA_DIVU, uA_DIV),
    EX_substage_csr             (uA_CSR),
    EX_substage_agu    [capacity:2] (uA_LOAD, uA_DCache),
    EX_substage_store  [capacity:2] (uA_STORE)
}

// EX Subpipeline
Pipeline {
    EX_subpipe_alu      (EX_substage_alu),
    EX_subpipe_mul      (EX_substage_mul_1 -> EX_substage_mul_2 -> EX_substage_mul_3 -> EX_substage_mul_4),
    EX_subpipe_branch   (EX_substage_branch),
    EX_subpipe_div      (EX_substage_div),
    EX_subpipe_csr      (EX_substage_csr),
    EX_subpipe_agu      (EX_substage_agu),
    EX_substage_store   (EX_substage_store)
}

// EX Stage
Stage {
  EX_stage_alu    [capacity:9] (EX_subpipe_csr, EX_subpipe_div, EX_subpipe_alu, EX_subpipe_mul, EX_subpipe_branch),
  EX_stage_agu    [capacity:2] (EX_subpipe_agu),
  EX_stage_store  [capacity:2] (EX_substage_store)
}

// OoO Pipeline
Pipeline {
  OoO_subpipe_alu    (IS_substage_alu -> LD_substage_alu -> EX_stage_alu),
  OoO_subpipe_agu    (IS_substage_agu -> LD_substage_agu -> EX_stage_agu),
  OoO_subpipe_store  (IS_substage_store -> LD_substage_store -> EX_stage_store)
}

Stage {
  IF_stage  [capacity:16] (IF_subpipe),
  DEC_stage [capacity:4]  (uA_Decode),
  RN_stage  [capacity:5]  (uA_Rename),
  OoO_stage [capacity:64, output-buffer] (OoO_subpipe_alu, OoO_subpipe_agu, OoO_subpipe_store),
  COM_stage [capacity:8]  (uA_Commit, uA_Commit_JB, uA_DCache_Store)
}

Pipeline RV32_4ISSUE_pipeline (IF_stage -> DEC_stage -> RN_stage -> OoO_stage -> COM_stage)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, addr, brTarget, imm, rs1_data, rs2_data}

Model iCacheModel [info-trace](
    link : "models/rv32_4issue/ICacheModel.h"
    trace : {pc}
    connectorIn : {Ic_in}
    connectorOut : {Ic_out}
)

Model regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

Model dynBranchPredModel [info-trace] (
    link : "models/rv32_4issue/BranchPredictionModel.h"
    trace : {pc, brTarget, rs1, rd, imm}
    connectorIn : {Pc_p, Pc_p_j, Pc_p_jr, Pc_c}
    connectorOut : {Pc_mp, Pc_pt}
)

Model staBranchPredModel [info-trace] (
  link : "models/rv32_4issue/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_p, Pc_p_j, Pc_p_jr, Pc_c}
  connectorOut : {Pc_mp, Pc_pt}
)

Model divider (
  link: "models/rv32_4issue/DividerModel.h"
  trace: rs2_data
)

Model divider_u (
  link: "models/rv32_4issue/DividerUnsignedModel.h"
  trace: rs2_data
)

Model dCacheModel [info-trace](
    link: "models/rv32_4issue/DCacheModel.h"
    trace : addr
    connectorIn : {Dc_in}
    connectorOut : {Dc_out}
)


/*********************************** Instruction Section ***********************************/
InstrGroup {
  OPC_REG_REG (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  OPC_REG_IMM (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  OPC_AUIPC   (auipc),
  OPC_LUI     (lui),
  Mul_Ra_Rb   (mul),
  MulH_Ra_Rb  (mulh, mulhu, mulhsu),
  Div_Ra_Rb   (div, rem),
  DivU_Ra_Rb  (divu, remu),
  Csr_Ra      (csrrw, csrrs, csrrc),
  Csr_X       (csrrwi, csrrsi, csrrci),
  OPC_STORE   (sb, sh, sw),
  OPC_LOAD    (lw, lh, lhu, lb, lbu),
  OPC_BRANCH  (beq, bne, blt, bge, bltu, bgeu),
  OPC_JAL     (jal),
  OPC_JALR    (jalr),
  Default ([?])
}

MicroactionMapping {
  [ALL]       :  {uA_PCGen, uA_PcCorrect, uA_CacheBlock, uA_ICacheCtrl, uA_PcPredict, uA_ICache, uA_Decode, uA_Rename},
  OPC_REG_REG :  {uA_IScan, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_Commit},
  OPC_REG_IMM :  {uA_IScan, uA_OF_A_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_Commit},
  OPC_AUIPC   :  {uA_IScan, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_Commit},
  OPC_LUI     :  {uA_IScan, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_Commit},
  Mul_Ra_Rb   :  {uA_IScan, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_MUL1, uA_MUL2, uA_MUL3, uA_MUL, uA_Commit},
  MulH_Ra_Rb  :  {uA_IScan, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_MUL1, uA_MUL2, uA_MUL3, uA_MUL, uA_Commit},
  Div_Ra_Rb   :  {uA_IScan, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_DIV, uA_Commit},
  DivU_Ra_Rb  :  {uA_IScan, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_DIVU, uA_Commit},
  Csr_Ra      :  {uA_IScan, uA_OF_A_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_CSR, uA_Commit},
  Csr_X       :  {uA_IScan, uA_Issue_ALU, uA_LookUP_ALU, uA_CSR, uA_Commit},
  OPC_STORE   :  {uA_IScan, uA_OF_A_store, uA_OF_B_store, uA_Issue_STORE, uA_LookUP_STORE, uA_STORE, uA_DCache_Store, uA_Commit},
  OPC_LOAD    :  {uA_IScan, uA_OF_A_agu, uA_Issue_AGU, uA_LookUP_AGU, uA_LOAD, uA_DCache, uA_Commit},
  OPC_BRANCH  :  {uA_IScan_br, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_Branch, uA_Commit_JB},
  OPC_JAL     :  {uA_IScan_j, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_Jr, uA_Commit_JB},
  OPC_JALR    :  {uA_IScan_jr, uA_OF_A_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_Jr, uA_Commit_JB}
}


TraceValueMapping {
  [ALL] : {
    pc = "$resolved{$pc}"
  },
  OPC_REG_REG : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  OPC_REG_IMM : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  OPC_AUIPC : {
    rd  = "$bitfield{rd}"
  },
  OPC_LUI : {
    rd  = "$bitfield{rd}"
  },
  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs1_data = "$reg{$bitfield{rs1}}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs1_data = "$reg{$bitfield{rs1}}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Csr_X : {
    rd  = "$bitfield{rd}"
  },
  OPC_STORE : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    addr = "($reg{$bitfield{rs1}} + $bitfield{imm})"
  },
  OPC_LOAD : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    addr = "($reg{$bitfield{rs1}} + $bitfield{imm})"
  },
  OPC_BRANCH : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$resolved{$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)}",
    imm = "$resolved{(((int16_t)($bitfield{imm} << 3)) >> 3)}"
  },
  OPC_JAL : {
    rd = "$bitfield{rd}",
    brTarget = "$resolved{$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)}",
    imm = "$resolved{(((int32_t)($bitfield{imm} << 11)) >> 11)}"
  },
  OPC_JALR : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + $resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}) & -2U",
    imm = "$resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}"
  }
}

/**************************************** Variants *****************************************/
CorePerfModel RV32_4ISSUE (
  core : "RV32IMACFD"
  use Pipeline : RV32_4ISSUE_pipeline
  use ConnectorModel : {regModel, dynBranchPredModel, iCacheModel, dCacheModel}
)