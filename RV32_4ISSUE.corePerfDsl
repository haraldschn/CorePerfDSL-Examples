/*********************************** Microaction Section ***********************************/
Connector {Pc_mp, Pc_pt, Pc_p, Pc_p_j, Pc_p_jr, Pc_c}
Connector {Ic_out, Ic_in}
Connector {Dc_out, Dc_in}
Connector {Xa, Xb, Xd}

Connector {Dec_INT, Dec_MUL, Dec_BR, Dec_CSR, Dec_DIV, EX_Alu, COM_Alu}
Connector {Issue_ALU}

Resource {PCGen(fetchAligner), ICacheCtrl, IScan, Decoder} 
Resource {Rename}
Resource {Issue(2)}
Resource {OperandLookup}
Resource {ALU, MUL(4), DIV(divider), DIVU(divider_u)}
Resource {STORE, LOAD}
Resource {ICache(iCacheModel), DCache(dCacheModel), DCache_Store(2)}
Resource {Commit}
Resource {WFC}

Microaction {
  uA_PCGen      (PCGen),
  uA_PcCorrect  (Pc_mp),
  uA_CacheBlock (Ic_out),

  uA_ICacheCtrl (ICacheCtrl),
  uA_PcPredict  (Pc_pt),
  uA_ICache     (ICache -> Ic_in),
  uA_IScan      (IScan),
  uA_IScan_br   (IScan -> Pc_p),
  uA_IScan_j    (IScan -> Pc_p_j),
  uA_IScan_jr   (IScan -> Pc_p_jr),

  uA_Decode        (Decoder),
  uA_Decode_alu    (Decoder -> Dec_INT),
  uA_Decode_mul    (Decoder -> Dec_MUL),
  uA_Decode_div    (Decoder -> Dec_DIV),
  uA_Decode_br     (Decoder -> Dec_BR),
  uA_Decode_csr    (Decoder -> Dec_CSR),

  uA_Rename        (Rename),

  uA_Issue_ALU     (Issue_ALU),
  uA_Issue_AGU     (Issue),

  uA_OF_A_alu      (Xa),
  uA_OF_A_agu      (Xa),
  uA_OF_B_alu      (Xb),
  uA_OF_B_agu      (Xb),

  uA_LookUP_ALU    (OperandLookup),
  uA_LookUP_AGU    (OperandLookup),
  uA_LookUP_STORE  (OperandLookup),

  uA_ALU_RegUpdate (ALU -> {Xd, EX_Alu}),
  uA_ALU_Branch    (ALU -> EX_Alu),
  uA_MUL           (MUL -> {Xd, EX_Alu}),
  uA_DIV           (DIV -> {Xd, EX_Alu}),
  uA_DIVU          (DIVU -> {Xd, EX_Alu}),

  uA_STORE         (STORE),
  uA_LOAD          (LOAD),

  uA_DCache        (DCache -> Xd),

  uA_WFC_alu       (WFC -> COM_Alu),
  uA_WFC_alu_JB    (WFC -> {Pc_c, COM_Alu}),

  uA_WFC_agu       (WFC),
  uA_WFC_store     (WFC),
  uA_DCache_Store  (DCache_Store),
  
  uA_Commit        (Commit)
}

/************************************ Stages & Pipeline ************************************/

// IF Substages
Stage {
    PC_substage   [capacity:4]  (uA_PCGen, uA_PcCorrect, uA_CacheBlock),
    IF_substage_0 [capacity:4]  (uA_ICacheCtrl),            // IFetchPipeline fetch0
    IF_substage_1 [capacity:4]  (uA_ICache, uA_PcPredict),  // IFetchPipeline fetch1
    IF_substage_2 [capacity:4]  (uA_IScan, uA_IScan_br, uA_IScan_j, uA_IScan_jr)
}

// IF Subpipeline
Pipeline IF_subpipe (PC_substage -> IF_substage_0 -> IF_substage_1 -> IF_substage_2)

// IssueQueue Substages
Stage {
  IS_substage_alu_OoO [capacity:24] (uA_Issue_ALU, uA_OF_A_alu, uA_OF_B_alu),
  IS_substage_agu     [capacity:16] (uA_Issue_AGU, uA_OF_A_agu, uA_OF_B_agu)
}

// OperandLookup Substages
Stage {
  LD_substage_alu_OoO [capacity:24] (uA_LookUP_ALU),
  LD_substage_agu     [capacity:16] (uA_LookUP_AGU, uA_LookUP_STORE)
}

// EX Stage
Stage {
  EX_stage_alu_OoO  [capacity:24] (uA_ALU_RegUpdate, uA_ALU_Branch, uA_MUL, uA_DIVU, uA_DIV),
  EX_stage_agu      [capacity:2]  (uA_LOAD, uA_STORE)
}

// WFC Stage
Stage {
  WFC_stage_alu [capacity: 64] (uA_WFC_alu, uA_WFC_alu_JB),
  WFC_stage_agu [capacity: 16] (uA_WFC_agu, uA_WFC_store, uA_DCache, uA_DCache_Store)
}

// OoO Pipeline
Pipeline {
  OoO_subpipe_alu    (IS_substage_alu_OoO -> LD_substage_alu_OoO -> EX_stage_alu_OoO -> WFC_stage_alu),
  OoO_subpipe_agu    (IS_substage_agu -> LD_substage_agu -> EX_stage_agu -> WFC_stage_agu)
}

Pipeline OoO_pipeline (OoO_subpipe_alu | OoO_subpipe_agu)

Stage {
  IF_stage  [capacity:16] (IF_subpipe),
  DEC_stage [capacity:4]  (uA_Decode, uA_Decode_alu, uA_Decode_mul, uA_Decode_div, uA_Decode_br, uA_Decode_csr),
  RN_stage  [capacity:5]  (uA_Rename),
  COM_stage [capacity:4]  (uA_Commit)
}

Pipeline RV32_4ISSUE_pipeline (IF_stage -> DEC_stage -> RN_stage -> OoO_pipeline -> COM_stage)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, addr, brTarget, imm, rs1_data, rs2_data}

Model iCacheModel [info-trace](
    link : "models/rv32_4issue/ICacheModel.h"
    trace : {pc}
    connectorIn : {Ic_in}
    connectorOut : {Ic_out}
)

Model regModel (
  link : "models/rv32_4issue/RegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

Model dynBranchPredModel [info-trace] (
    link : "models/rv32_4issue/BranchPredictionModel.h"
    trace : {pc, brTarget, rs1, rd, imm}
    connectorIn : {Pc_p, Pc_p_j, Pc_p_jr, Pc_c}
    connectorOut : {Pc_mp, Pc_pt}
)

Model staBranchPredModel [info-trace] (
  link : "models/rv32_4issue/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_p, Pc_p_j, Pc_p_jr, Pc_c}
  connectorOut : {Pc_mp, Pc_pt}
)

Model divider (
  link: "models/rv32_4issue/DividerModel.h"
  trace: rs2_data
)

Model divider_u (
  link: "models/rv32_4issue/DividerUnsignedModel.h"
  trace: rs2_data
)

Model dCacheModel [info-trace](
    link: "models/rv32_4issue/DCacheModel.h"
    trace : addr
    connectorIn : {Dc_in}
    connectorOut : {Dc_out}
)

Model fetchAligner (
    link : "models/rv32_4issue/FetchAligner.h"
    trace : pc
)

Model scheduler (
    link : "models/rv32_4issue/Scheduler.h"
    trace : pc
    connectorIn : {Dec_INT, Dec_MUL, Dec_BR, Dec_CSR, Dec_DIV, EX_Alu, COM_Alu}
    connectorOut : {Issue_ALU}
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  OPC_REG_REG (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  OPC_REG_IMM (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  OPC_AUIPC   (auipc),
  OPC_LUI     (lui),
  Mul_Ra_Rb   (mul),
  MulH_Ra_Rb  (mulh, mulhu, mulhsu),
  Div_Ra_Rb   (div, rem),
  DivU_Ra_Rb  (divu, remu),
  Csr_Ra      (csrrw, csrrs, csrrc),
  Csr_X       (csrrwi, csrrsi, csrrci),
  OPC_STORE   (sb, sh, sw),
  OPC_LOAD    (lw, lh, lhu, lb, lbu),
  OPC_BRANCH  (beq, bne, blt, bge, bltu, bgeu),
  OPC_JAL     (jal),
  OPC_JALR    (jalr),
  Default ([?])
}

MicroactionMapping {
  [ALL]       :  {uA_PCGen, uA_PcCorrect, uA_CacheBlock, uA_ICacheCtrl, uA_PcPredict, uA_ICache, uA_Rename, uA_Commit},
  OPC_REG_REG :  {uA_IScan, uA_Decode_alu, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_WFC_alu},
  OPC_REG_IMM :  {uA_IScan, uA_Decode_alu, uA_OF_A_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_WFC_alu},
  OPC_AUIPC   :  {uA_IScan, uA_Decode_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_WFC_alu},
  OPC_LUI     :  {uA_IScan, uA_Decode_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_WFC_alu},
  Mul_Ra_Rb   :  {uA_IScan, uA_Decode_mul, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_MUL, uA_WFC_alu},
  MulH_Ra_Rb  :  {uA_IScan, uA_Decode_mul, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_MUL, uA_WFC_alu},
  Div_Ra_Rb   :  {uA_IScan, uA_Decode_div, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_DIV, uA_WFC_alu},
  DivU_Ra_Rb  :  {uA_IScan, uA_Decode_div, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_DIVU, uA_WFC_alu},
  Csr_Ra      :  {uA_IScan, uA_Decode_csr, uA_OF_A_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_WFC_alu},
  Csr_X       :  {uA_IScan, uA_Decode_csr, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_WFC_alu},
  OPC_STORE   :  {uA_IScan, uA_Decode, uA_Issue_AGU, uA_OF_A_agu, uA_OF_B_agu, uA_LookUP_STORE, uA_STORE, uA_DCache_Store, uA_WFC_store},
  OPC_LOAD    :  {uA_IScan, uA_Decode, uA_Issue_AGU, uA_OF_A_agu, uA_LookUP_AGU, uA_LOAD, uA_DCache, uA_WFC_agu},
  OPC_BRANCH  :  {uA_IScan_br, uA_Decode_br, uA_OF_A_alu, uA_OF_B_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_Branch, uA_WFC_alu_JB},
  OPC_JAL     :  {uA_IScan_j, uA_Decode_br, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_WFC_alu_JB},
  OPC_JALR    :  {uA_IScan_jr, uA_Decode_br, uA_OF_A_alu, uA_Issue_ALU, uA_LookUP_ALU, uA_ALU_RegUpdate, uA_WFC_alu_JB}
}


TraceValueMapping {
  [ALL] : {
    pc = "$resolved{$pc}"
  },
  OPC_REG_REG : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  OPC_REG_IMM : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  OPC_AUIPC : {
    rd  = "$bitfield{rd}"
  },
  OPC_LUI : {
    rd  = "$bitfield{rd}"
  },
  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs1_data = "$reg{$bitfield{rs1}}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs1_data = "$reg{$bitfield{rs1}}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Csr_X : {
    rd  = "$bitfield{rd}"
  },
  OPC_STORE : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    addr = "($reg{$bitfield{rs1}} + $bitfield{imm})"
  },
  OPC_LOAD : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    addr = "($reg{$bitfield{rs1}} + $bitfield{imm})"
  },
  OPC_BRANCH : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$resolved{$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)}",
    imm = "$resolved{(((int16_t)($bitfield{imm} << 3)) >> 3)}"
  },
  OPC_JAL : {
    rd = "$bitfield{rd}",
    brTarget = "$resolved{$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)}",
    imm = "$resolved{(((int32_t)($bitfield{imm} << 11)) >> 11)}"
  },
  OPC_JALR : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + $resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}) & -2U",
    imm = "$resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}"
  }
}

/**************************************** Variants *****************************************/
CorePerfModel RV32_4ISSUE (
  core : "RV32IMACFD"
  use Pipeline : RV32_4ISSUE_pipeline
  use ConnectorModel : {regModel, dynBranchPredModel, iCacheModel, dCacheModel, scheduler}
)